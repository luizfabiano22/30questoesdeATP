#include <stdio.h>

int main() {

//declaracao de variaveis
    int quantidade;
    int a = 0;
    int b = 1;
    int proximo;
//pocessamento
    printf("Quantos termos? ");
    scanf("%d", &quantidade);

    for (int i = 0; i < quantidade; i++) {

        printf("%d ", a);

        proximo = a + b;

        a = b;
        b = proximo;
    }

    return 0;
}

